        <property name="styleSheet">
         <string notr="true">QComboBox {
    background-color: white; /* Fond blanc */
    color: black; /* Texte noir */
    font-size: 14px; /* Taille du texte */
    border: 1px solid #dcdcdc; /* Bordure gris clair */
    border-radius: 5px; /* Coins arrondis */
    padding: 5px;
}

/* Style pour la liste déroulante */
QComboBox QAbstractItemView {
    background-color: white; /* Fond blanc */
    color: black; /* Texte noir */
    selection-background-color: #c5cae9; /* Fond bleu clair pour l'élément sélectionné */
    selection-color: black; /* Texte noir pour l'élément sélectionné */
    border: 1px solid #dcdcdc;
}

/* Style pour la flèche du QComboBox */
QComboBox::drop-down {
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(:/icons/down-arrow-black.png); /* Icône de flèche personnalisée en noir */
}

/* Option pour une flèche noire par défaut (si tu n'as pas l'image personnalisée) */
QComboBox::down-arrow {
    border: 1px solid black; /* Bordure noire pour la flèche */
    border-radius: 3px; /* Coins arrondis pour la flèche */
}
</string>
